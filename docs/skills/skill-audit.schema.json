{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spark.local/schemas/skill-audit.v1.json",
  "title": "Spark SKILL-02 engineering skill audit",
  "type": "object",
  "required": ["schema_version", "audit", "measurement", "decision_summary", "skills", "adjacent_not_comparable"],
  "properties": {
    "schema_version": {"const": "skill-audit.v1"},
    "audit": {
      "type": "object",
      "required": ["id", "date", "branch", "base_commit", "scope", "read_only_roots"],
      "properties": {
        "id": {"const": "SKILL-02"},
        "date": {"type": "string", "format": "date"},
        "branch": {"type": "string"},
        "base_commit": {"type": "string", "minLength": 7},
        "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "read_only_roots": {"type": "array", "minItems": 2, "items": {"type": "string"}}
      }
    },
    "measurement": {
      "type": "object",
      "required": ["byte_definition", "index_definition", "token_estimator", "usage_source", "content_eval_status"],
      "properties": {
        "byte_definition": {"type": "string"},
        "index_definition": {"type": "string"},
        "token_estimator": {"type": "string"},
        "usage_source": {"type": "string"},
        "content_eval_status": {"type": "string"}
      }
    },
    "decision_summary": {"type": "object"},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "capability", "source_kind", "source_path", "trigger", "steps", "references", "completion_criteria", "invocation", "size", "usage", "provenance", "license", "eval_coverage", "overlaps", "decision", "rationale"],
        "properties": {
          "name": {"type": "string"},
          "capability": {"type": "string"},
          "source_kind": {"enum": ["external_installed", "spark_bundled", "codex_bundled"]},
          "source_path": {"type": "string"},
          "trigger": {"type": "string"},
          "steps": {"type": "array", "items": {"type": "string"}},
          "references": {"type": "array", "items": {"type": "string"}},
          "completion_criteria": {"type": "array", "items": {"type": "string"}},
          "invocation": {"type": "object", "required": ["policy", "user_invocable", "model_invocable"]},
          "size": {"type": "object", "required": ["skill_md_bytes", "skill_md_lines", "index_entry_bytes", "estimated_index_tokens"]},
          "usage": {"type": "object"},
          "provenance": {"type": "object", "required": ["kind", "declared_metadata"]},
          "license": {"type": "object", "required": ["declared", "assessment"]},
          "eval_coverage": {"type": "object", "required": ["content", "runtime"]},
          "overlaps": {"type": "array", "items": {"type": "string"}},
          "decision": {"enum": ["keep-external", "improve-bundled", "merge-bundled", "archive-bundled"]},
          "rationale": {"type": "string"}
        }
      }
    },
    "adjacent_not_comparable": {"type": "array", "items": {"type": "object"}}
  }
}
